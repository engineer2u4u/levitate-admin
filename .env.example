# Supabase — Project Settings → Data API (URL) and API Keys (anon/publishable).
# Both values are safe in the browser: the anon key only grants what your Row
# Level Security policies allow. Never put the service_role key here — it
# bypasses RLS entirely and this app ships to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Where emailed invite and sign-in links should land. Leave blank and the app
# uses the origin the invite was sent from, which is right for a normal deploy.
# Set it when the admin lives in a subfolder or on a different hostname than
# the Site URL configured in Supabase.
NEXT_PUBLIC_ADMIN_URL=

# Only for running migrations from this machine with the Supabase CLI. Not read
# by the app, never shipped to the browser, and it belongs in .env.local (which
# is gitignored) — never here with a value in it.
#
# Supabase Dashboard -> Project Settings -> Database -> Database password.
# Then:  npx supabase db push --linked --password "$SUPABASE_DB_PASSWORD" --yes
#
# Needed because the CLI's own connection path returns 403 on this account:
# it provisions a temporary database login role through the Management API, and
# that endpoint requires org Owner/Administrator privileges. A password goes
# straight to Postgres and skips that entirely.
# SUPABASE_DB_PASSWORD=
